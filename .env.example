# Execução local com Maven ou IDE (a aplicação roda na máquina anfitriã).
DATA_BASE_URL=jdbc:postgresql://localhost:5432/nexos
DATA_BASE_USERNAME=nexos
DATA_BASE_PASSWORD=troque-por-uma-senha-local-segura

# PostgreSQL criado pelo Docker Compose.
POSTGRES_DB=nexos

# Segurança e administrador inicial.
# JWT_SECRET deve possuir pelo menos 32 caracteres.
JWT_SECRET=troque-por-uma-chave-local-com-no-minimo-32-caracteres
ADMIN_NAME=Administrador NexOS
ADMIN_EMAIL=admin@nexos.local
ADMIN_PASSWORD=troque-por-uma-senha-inicial-segura

# Portas expostas pela execução com Docker Compose.
API_PORT=8080
POSTGRES_PORT=5432
